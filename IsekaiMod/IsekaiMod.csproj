<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>IsekaiMod</AssemblyName>
    <RootNamespace>IsekaiMod</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <WrathPath>C:\Program Files (x86)\Steam\steamapps\common\Pathfinder Second Adventure</WrathPath>
    <GameReferencePath>$(MSBuildProjectDirectory)\..\lib\Assembly-CSharp.dll</GameReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
